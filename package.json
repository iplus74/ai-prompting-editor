{
  "name": "ai-prompt-editor",
  "version": "1.0.0",
  "description": "Electron desktop editor for creating and managing AI prompting markdown documents with GitHub Copilot SDK integration.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.iplus74.ai-prompt-editor",
    "productName": "Promptify",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@github/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11"
  }
}
